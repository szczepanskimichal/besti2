+    display: flex;
+    flex-direction: column;
+    align-items: flex-start;
+    gap: 8px;
+    padding: 14px 16px;
+    border: 1.5px solid rgba(191, 248, 232, 0.2);
+    border-radius: 18px;
+    background: rgba(3, 15, 22, 0.55);
+}
+/* Waiting for the business: a soft lilac edge */
+.cardWaiting {
+    border-color: rgba(201, 191, 255, 0.55);
+    box-shadow: 0 0 10px rgba(201, 191, 255, 0.18);
+}
+.hidden {
+    border: 1.5px dashed rgba(80, 130, 230, 0.6);
+}
+.cardHead {
+    display: flex;
+    align-items: baseline;
+    justify-content: space-between;
+    gap: 12px;
+    width: 100%;
+}
+.name {
+    margin: 0;
+    color: #ffffff;
+    font: 700 1.0625rem var(--font-heading);
+    overflow-wrap: anywhere;
+}
+.date {
+    margin: 0;
+    color: #a9bdb8;
+    font: 400 0.8125rem var(--font-small);
+    white-space: nowrap;
+}
+.comment {
+    margin: 0;
+    color: #e6f7f2;
+    font: 400 1rem/1.55 var(--font-small);
+}
+.photo {
+    max-width: 220px;
+    max-height: 220px;
+    border-radius: 14px;
+    object-fit: cover;
+}
+.helpful {
+    display: flex;
+    align-items: center;
+    gap: 6px;
+    margin: 0;
+    color: #cfeee6;
+    font: 400 0.875rem var(--font-small);
+}
+.hiddenNote {
+    margin: 0;
+    padding: 8px 12px;
+    border: 1.5px solid rgba(80, 130, 230, 0.75);
+    border-radius: 14px;
+    background: rgba(12, 28, 70, 0.65);
+    color: #9fc4ff;
+    font: 400 0.875rem/1.5 var(--font-small);
+}
+
+/* The business's answer: a calm mint box, like the answer on the business page */
+.reply {
+    align-self: stretch;
+    padding: 10px 14px;
+    border-left: 3px solid #8ff0d6;
+    border-radius: 6px 14px 14px 6px;
+    background: rgba(80, 225, 190, 0.1);
+}
+.replyLabel {
+    margin: 0 0 2px;
+    color: #8ff0d6;
+    font: 700 0.875rem var(--font-heading);
+}
+.replyText {
+    margin: 0;
+    color: #dffcf3;
+    font: 400 0.9375rem/1.5 var(--font-small);
+}
+
+/* Lilac neon stamp: the customer is waiting for your answer */
+.stamp {
+    margin: 0;
+    padding: 4px 12px;
+    border: 2px solid #c9bfff;
+    border-radius: 999px;
+    background: linear-gradient(rgba(150, 128, 255, 0.24), rgba(150, 128, 255, 0.24)), var(--color-input-bg);
+    color: #ffffff;
+    box-shadow: 0 0 14px rgba(201, 191, 255, 0.5), inset 0 0 18px rgba(170, 150, 255, 0.25);
+    text-shadow: 0 0 8px rgba(189, 176, 255, 0.95);
+    font: 700 0.8125rem var(--font-heading);
+}
+
+/* Answer: the field opens after a click */
+.more {
+    display: flex;
+    flex-direction: column;
+    gap: 10px;
+    align-self: stretch;
+}
+.pill {
+    display: inline-flex;
+    align-items: center;
+    align-self: flex-start;
+    min-height: 40px;
