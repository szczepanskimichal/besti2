+/* Ready answers as pills with a crystal icon, like "Skriv en liten hilsen" on the invitation */
+.chips {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 8px;
+}
+.chip {
+    padding: 8px 14px;
+    border: 1px solid rgba(191, 248, 232, 0.6);
+    border-radius: 999px;
+    background: var(--color-input-bg);
+    color: #eefcf7;
+    font: 600 0.875rem var(--font-heading);
+    cursor: pointer;
+}
+.chipOn {
+    border-color: #bff8e8;
+    background: rgba(191, 248, 232, 0.2);
+    box-shadow: 0 0 12px rgba(191, 248, 232, 0.5);
+    color: #ffffff;
+}
+.chip:focus-visible {
+    outline: 2px solid var(--color-primary);
+    outline-offset: 3px;
+}
+.chipIcon {
+    width: 22px;
+    height: 22px;
+    margin: -4px -2px -4px 6px;
+    vertical-align: middle;
+    filter: drop-shadow(0 0 4px rgba(159, 240, 218, 0.5));
+}
+
+.saveButton {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    align-self: flex-start;
+    min-height: 44px;
+    padding: 0 22px;
+    border: 2px solid transparent;
+    border-radius: 999px;
+    background: linear-gradient(var(--color-primary), var(--color-primary)) padding-box, var(--neon-border) border-box;
+    color: var(--color-on-primary);
+    box-shadow: var(--neon-glow);
+    font: 700 0.9375rem var(--font-heading);
+    cursor: pointer;
+}
+.saveButton:disabled {
+    opacity: 0.6;
+    cursor: default;
+}
+.saveButton:focus-visible {
+    outline: 2px solid var(--color-primary);
+    outline-offset: 3px;
+}
+
+@media (min-width: 700px) {
+    .hero {
+        padding: 20px 24px;
+    }
+    .section {
+        padding: 18px 24px 20px;
+    }
+    .list {
+        display: grid;
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+        align-items: start;
+    }
+}
