+@media (min-width: 700px) {
+    .rewardRow .sheet {
+        width: auto;
+        margin-left: 0;
+    }
+    .rewardRow {
+        grid-template-columns: repeat(3, minmax(0, 1fr));
+        max-width: 900px;
+    }
+    .rewardRow .saveButton,
+    .rewardRow .pillDanger {
+        font-size: 0.9375rem;
+    }
+    .rewardRow .rewardInput {
+        grid-column: auto;
+    }
 }
