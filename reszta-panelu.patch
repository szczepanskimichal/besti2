@@ -0,0 +1,402 @@
+/* Vurderinger (Ada 2026-11-01): the same dark glass look as Stempelkort, Profil and Tjenester.
+   Mint = answered, lilac = waits for the business's answer, blue = hidden by BESTI. Headings and numbers in Syne */
+.notice {
+    margin: 0 0 16px;
+    padding: 10px 16px;
+    border: 1px solid rgba(114, 214, 189, 0.6);
+    border-radius: 999px;
+    background: rgba(114, 214, 189, 0.1);
+    color: #bff8e8;
+    box-shadow: 0 0 10px rgba(114, 214, 189, 0.25);
+    font: 600 0.9375rem var(--font-heading);
+}
+.error {
+    margin: 0 0 12px;
+    padding: 10px 14px;
+    border: 1px solid #7fb2ff;
+    border-radius: 14px;
+    background: rgba(12, 28, 70, 0.55);
+    color: #cfe0ff;
+}
+.small {
+    margin: 0;
+    color: #a9bdb8;
+    font: 400 0.875rem/1.5 var(--font-small);
+}
+
+/* Glass cards */
+.hero,
+.section {
+    display: flex;
+    flex-direction: column;
+    gap: 14px;
+    min-width: 0;
+    margin: 0 0 12px;
+    padding: 14px 16px 16px;
+    border: 1.5px solid rgba(191, 248, 232, 0.28);
+    border-radius: 18px;
+    background: rgba(5, 17, 24, 0.82);
+    backdrop-filter: var(--glass-blur);
+}
+.hero {
+    margin-top: 20px;
+    border-radius: 22px;
+}
+.heroEmpty {
+    margin: 0;
+    color: #ffffff;
+    font: 700 1.25rem var(--font-heading);
+}
+
+/* The average: a big glowing mint number with the crystal stars beside it */
+.score {
+    display: flex;
+    align-items: center;
+    gap: 16px;
+}
+/* Only the big number in Inter (Ada 2026-11-01), the rest of the page keeps Syne */
+.average {
+    margin: 0;
+    color: #8ff0d6;
+    font: 700 3.5rem/1 var(--font-small);
+    letter-spacing: -0.02em;
+    text-shadow: 0 0 14px rgba(143, 240, 214, 0.55);
+}
+.scoreText {
+    display: flex;
+    flex-direction: column;
+    gap: 6px;
+    min-width: 0;
+}
+/* Big crystal stars beside the average */
+.scoreText [role="img"] {
+    gap: 4px;
+}
+.scoreText [role="img"] img {
+    width: 44px;
+    height: 44px;
+}
+
+/* Two glass tiles: new in 30 days, and waiting for an answer (lilac while something waits) */
+.tiles {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 10px;
+    max-width: 480px;
+}
+/* "nye siste 30 dager": black inside with a glowing mint line, like the Gratis BESTI-tjeneste field on Stempelkort */
+.tile {
+    display: flex;
+    flex-direction: column;
+    gap: 2px;
+    margin: 0;
+    padding: 10px 14px;
+    border: 2px solid #8ff0d6;
+    border-radius: 18px;
+    background: #03090d;
+    box-shadow: 0 0 14px rgba(143, 240, 214, 0.6), 0 0 26px rgba(114, 230, 200, 0.3), inset 0 0 18px rgba(114, 230, 200, 0.28);
+}
+.tileNumber {
+    color: #8ff0d6;
+    font: 700 1.75rem/1.1 var(--font-heading);
+    text-shadow: 0 0 10px rgba(143, 240, 214, 0.5);
+}
+.tileText {
+    color: #cfeee6;
+    font: 400 0.8125rem var(--font-small);
+}
+/* "venter på svar": exactly the lilac "venter" pill from the invitation (even lilac neon line, dark inside
+   with a lilac tint and inner glow), only the number */
+.tileWaiting {
+    border: 2px solid #c9bfff;
+    background: linear-gradient(rgba(150, 128, 255, 0.24), rgba(150, 128, 255, 0.24)), var(--color-input-bg);
+    box-shadow: 0 0 14px rgba(201, 191, 255, 0.5), inset 0 0 18px rgba(170, 150, 255, 0.25);
+}
+.tileWaiting .tileNumber {
+    color: #ffffff;
+    text-shadow: 0 0 8px rgba(189, 176, 255, 0.95);
+}
+.tileWaiting .tileText {
+    color: #e6e0ff;
+}
+.sectionTitle {
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    margin: 0;
+    color: #ffffff;
+    font: 700 1.25rem var(--font-heading);
+}
+.count {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    min-width: 36px;
+    height: 36px;
+    padding: 0 10px;
+    border: 2px solid #8ff0d6;
+    border-radius: 999px;
+    background: rgba(80, 225, 190, 0.28);
+    color: #ffffff;
+    font: 700 1.25rem/1 var(--font-heading);
+    box-shadow: 0 0 8px rgba(143, 240, 214, 0.9), 0 0 20px rgba(114, 230, 200, 0.55);
+}
+
+/* Review cards */
+.list {
+    display: flex;
+    flex-direction: column;
+    gap: 12px;
+    margin: 0;
+    padding: 0;
+    list-style: none;
+}
+.card,
