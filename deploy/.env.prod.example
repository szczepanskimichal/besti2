# /opt/besti/.env on the server (chmod 600). Never commit the real file.
MSSQL_SA_PASSWORD=change-me-long-random
ConnectionStrings__DefaultConnection=Server=sqlserver;Database=besti2;User Id=sa;Password=change-me-long-random;TrustServerCertificate=True
Smtp__Host=smtp-relay.brevo.com
Smtp__Port=587
Smtp__Username=brevo-login
Smtp__Password=brevo-smtp-key
Smtp__From=BESTI <post@bestiapp.no>

# Ping URL from healthchecks.io for the nightly backup (optional)
BACKUP_PING_URL=https://hc-ping.com/your-check-uuid
