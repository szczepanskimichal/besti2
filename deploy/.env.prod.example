# /opt/besti/.env on the server (chmod 600). Never commit the real file.
MSSQL_SA_PASSWORD=change-me-long-random
# API logs in as besti_app (db_owner only in besti2); sa is only for backup.sh and the healthcheck.
# After restoring besti2.bak on a NEW server: CREATE LOGIN besti_app, then in besti2: ALTER USER besti_app WITH LOGIN = besti_app
ConnectionStrings__DefaultConnection=Server=sqlserver;Database=besti2;User Id=besti_app;Password=change-me-long-random-2;TrustServerCertificate=True
Smtp__Host=smtp-relay.brevo.com
Smtp__Port=587
Smtp__Username=brevo-login
Smtp__Password=brevo-smtp-key
Smtp__From=BESTI <post@bestiapp.no>

# Ping URL from healthchecks.io for the nightly backup (optional)
BACKUP_PING_URL=https://hc-ping.com/your-check-uuid
